#!/usr/bin/env bash
# Forja post-commit hook
# Sella el plano de control con el commit recién creado y valida su integridad (A1, R17).
#
#   - Estampa cada evento de .plan/activity.log.jsonl con "commit":null → el hash de HEAD.
#     Así cada nota / captura / cambio de estado queda atado a un commit (trazabilidad por grep).
#     (El re-sellado se commitea en el SIGUIENTE commit — post-commit no puede modificar el actual.)
#   - Valida plan.json + cada línea del log. Si algo no parsea, NO puede abortar (el commit ya
#     ocurrió) — deja un marcador .plan/.inconsistent que el PRÓXIMO pre-commit gatea fail-closed (R17).
#
# Degradación segura: si no hay .plan/, no hace nada. Source: CONSTRAINTS.md R17 · docs/07 §5.1.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
PLAN_DIR="$REPO_ROOT/.plan"
[[ -d "$PLAN_DIR" ]] || exit 0
SHA="$(git rev-parse HEAD 2>/dev/null)" || exit 0
command -v node >/dev/null 2>&1 || exit 0

node - "$PLAN_DIR" "$SHA" <<'NODE'
const fs = require('fs'), path = require('path')
const [dir, sha] = process.argv.slice(2)
const planFile = path.join(dir, 'plan.json')
const logFile = path.join(dir, 'activity.log.jsonl')
const marker = path.join(dir, '.inconsistent')
let inconsistent = false

// 1) validate plan.json
if (fs.existsSync(planFile)) {
  try {
    const p = JSON.parse(fs.readFileSync(planFile, 'utf8'))
    if (!p.project || !Array.isArray(p.phases)) throw new Error('falta project/phases')
  } catch (e) { console.error('⚠️  post-commit: plan.json inválido (' + e.message + ')'); inconsistent = true }
}

// 2) seal events with the commit + validate each log line
if (fs.existsSync(logFile)) {
  const lines = fs.readFileSync(logFile, 'utf8').split('\n')
  const out = []; let changed = false
  for (const l of lines) {
    if (!l.trim()) { out.push(l); continue }
    let ev
    try { ev = JSON.parse(l) } catch { console.error('⚠️  post-commit: línea de log inválida'); inconsistent = true; out.push(l); continue }
    if (ev.commit === null || ev.commit === undefined) { ev.commit = sha; changed = true }
    out.push(JSON.stringify(ev))
  }
  if (changed) fs.writeFileSync(logFile, out.join('\n'))
}

// 3) inconsistency marker — gateado fail-closed por el próximo pre-commit (R17)
if (inconsistent) fs.writeFileSync(marker, sha + '\n')
else { try { fs.unlinkSync(marker) } catch {} }
NODE

exit 0
