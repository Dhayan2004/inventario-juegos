import { cva, type VariantProps } from 'class-variance-authority'
import { cn } from '@/lib/cn'
import { type ComponentPropsWithoutRef, type ReactNode } from 'react'

// ─── Sidebar (vertical primary nav) ─────────────────────────────────────

export interface SidebarProps extends ComponentPropsWithoutRef<'aside'> {
  title?: ReactNode
  children: ReactNode
}

export function Sidebar({ title, className, children, ...props }: SidebarProps) {
  return (
    <aside
      role="navigation"
      aria-label="Sidebar"
      className={cn(
        'flex h-screen w-60 flex-col border-r border-border bg-surface-elevated px-3 py-4',
        className
      )}
      {...props}
    >
      {title && (
        <div className="mb-4 px-2 font-display text-sm font-semibold text-text">{title}</div>
      )}
      <nav className="flex flex-1 flex-col gap-1">{children}</nav>
    </aside>
  )
}

const sidebarItemVariants = cva(
  'flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary',
  {
    variants: {
      active: {
        true:  'bg-surface-higher text-text',
        false: 'text-text-muted hover:text-text hover:bg-surface',
      },
    },
    defaultVariants: { active: false },
  }
)

export interface SidebarItemProps
  extends ComponentPropsWithoutRef<'a'>,
    VariantProps<typeof sidebarItemVariants> {
  icon?: ReactNode
}

export function SidebarItem({ active, icon, className, children, ...props }: SidebarItemProps) {
  return (
    <a
      aria-current={active ? 'page' : undefined}
      className={cn(sidebarItemVariants({ active }), className)}
      {...props}
    >
      {icon && <span className="text-text-subtle" aria-hidden>{icon}</span>}
      {children}
    </a>
  )
}

// ─── Topbar (horizontal utility nav) ────────────────────────────────────

export interface TopbarProps extends ComponentPropsWithoutRef<'header'> {
  brand?: ReactNode
  actions?: ReactNode
}

export function Topbar({ brand, actions, className, children, ...props }: TopbarProps) {
  return (
    <header
      role="banner"
      className={cn(
        'flex h-14 items-center justify-between gap-4 border-b border-border bg-surface px-4',
        className
      )}
      {...props}
    >
      {brand && <div className="flex items-center gap-2 font-display font-semibold text-text">{brand}</div>}
      <nav role="navigation" aria-label="Topbar" className="flex items-center gap-1">
        {children}
      </nav>
      {actions && <div className="flex items-center gap-2">{actions}</div>}
    </header>
  )
}

// ─── Tabs (Radix when shadcn detected; from-scratch fallback) ──────────

'use client'

import * as TabsPrimitive from '@radix-ui/react-tabs'

const tabsListVariants = cva(
  'inline-flex h-10 items-center justify-start border-b border-border'
)

const tabsTriggerVariants = cva(
  '-mb-px inline-flex h-10 items-center justify-center px-4 text-sm font-medium text-text-muted transition-colors duration-fast hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface data-[state=active]:text-text data-[state=active]:border-b-2 data-[state=active]:border-primary disabled:opacity-50 disabled:cursor-not-allowed'
)

export const Tabs = TabsPrimitive.Root

export function TabsList({ className, ...props }: ComponentPropsWithoutRef<typeof TabsPrimitive.List>) {
  return <TabsPrimitive.List className={cn(tabsListVariants(), className)} {...props} />
}

export function TabsTrigger({
  className,
  ...props
}: ComponentPropsWithoutRef<typeof TabsPrimitive.Trigger>) {
  return <TabsPrimitive.Trigger className={cn(tabsTriggerVariants(), className)} {...props} />
}

export function TabsContent({
  className,
  ...props
}: ComponentPropsWithoutRef<typeof TabsPrimitive.Content>) {
  return (
    <TabsPrimitive.Content
      className={cn(
        'mt-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary',
        className
      )}
      {...props}
    />
  )
}

// ─── Breadcrumb ─────────────────────────────────────────────────────────

export interface BreadcrumbProps extends ComponentPropsWithoutRef<'nav'> {
  separator?: ReactNode
}

export function Breadcrumb({ separator = '/', className, children, ...props }: BreadcrumbProps) {
  return (
    <nav aria-label="Breadcrumb" className={cn('flex items-center', className)} {...props}>
      <ol className="flex items-center gap-2 text-sm text-text-muted">
        {children}
      </ol>
    </nav>
  )
}

export function BreadcrumbItem({
  current,
  className,
  children,
  ...props
}: ComponentPropsWithoutRef<'li'> & { current?: boolean }) {
  return (
    <li
      className={cn('flex items-center gap-2', current && 'text-text font-medium', className)}
      aria-current={current ? 'page' : undefined}
      {...props}
    >
      {children}
    </li>
  )
}

export function BreadcrumbSeparator({ children = '/' }: { children?: ReactNode }) {
  return (
    <span aria-hidden className="text-text-subtle">
      {children}
    </span>
  )
}
