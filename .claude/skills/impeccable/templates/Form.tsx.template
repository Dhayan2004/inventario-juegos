import { cva, type VariantProps } from 'class-variance-authority'
import { cn } from '@/lib/cn'
import { forwardRef, type ComponentPropsWithoutRef, type ReactNode } from 'react'

// ─── Input ────────────────────────────────────────────────────────────

const inputVariants = cva(
  'block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text placeholder:text-text-subtle transition-colors duration-fast focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary disabled:opacity-50 disabled:cursor-not-allowed aria-[invalid=true]:border-danger',
  {
    variants: {
      variant: {
        text:   'h-10',
        search: 'h-10 pl-10', // pl-10 leaves room for icon-left
      },
      tone: {
        neutral: '',
        error:   'border-danger ring-danger',
      },
    },
    defaultVariants: { variant: 'text', tone: 'neutral' },
  }
)

export interface InputProps
  extends ComponentPropsWithoutRef<'input'>,
    VariantProps<typeof inputVariants> {
  /** Visible label by default (R-005 sec 3.1 forms — Visible label by default). */
  label?: string
  /** Helper text below the input. */
  hint?: string
  /** Error message shown below — uses --color-danger. Sets aria-invalid. */
  error?: string
}

export const Input = forwardRef<HTMLInputElement, InputProps>(function Input(
  { className, variant, tone, label, hint, error, id, required, ...props },
  ref
) {
  const localId = id ?? `input-${useUniqueId()}`
  const describedBy = error ? `${localId}-error` : hint ? `${localId}-hint` : undefined
  return (
    <div className="space-y-1">
      {label && (
        <label htmlFor={localId} className="block text-sm font-medium text-text">
          {label}
          {required && <span className="ml-0.5 text-danger" aria-hidden>*</span>}
        </label>
      )}
      <input
        ref={ref}
        id={localId}
        className={cn(inputVariants({ variant, tone: error ? 'error' : tone }), className)}
        aria-invalid={Boolean(error) || undefined}
        aria-describedby={describedBy}
        required={required}
        {...props}
      />
      {error ? (
        <p id={`${localId}-error`} role="alert" className="text-xs text-danger">
          {error}
        </p>
      ) : hint ? (
        <p id={`${localId}-hint`} className="text-xs text-text-subtle">
          {hint}
        </p>
      ) : null}
    </div>
  )
})

// ─── SearchInput (compose Input with Search icon left) ────────────────

export interface SearchInputProps extends Omit<InputProps, 'variant'> {
  iconLeft?: ReactNode
}

export const SearchInput = forwardRef<HTMLInputElement, SearchInputProps>(function SearchInput(
  { iconLeft, className, ...props },
  ref
) {
  return (
    <div className="relative">
      <span
        className="absolute left-3 top-1/2 -translate-y-1/2 text-text-subtle"
        aria-hidden
      >
        {iconLeft ?? <SearchIcon />}
      </span>
      <Input ref={ref} variant="search" className={className} {...props} />
    </div>
  )
})

