// ─── helpers ──────────────────────────────────────────────────────────

let uid = 0
function useUniqueId() {
  // Server-safe deterministic id within a module instance.
  // For SSR-stable ids, consumers should pass `id` explicitly.
  return ++uid
}

function SearchIcon() {
  return (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
      <circle cx="11" cy="11" r="7" />
      <path d="M21 21l-4.3-4.3" />
    </svg>
  )
}
