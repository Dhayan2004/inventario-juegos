// Generated by add-e2e-tests. [memory:decisions#D-026] · [docs:playwright]
// Auth setup runs once before authenticated specs. It logs in with credentials
// from env vars and saves the storageState. Compatible with add-login Supabase
// flows — adapt the selectors if your sign-in form differs.

import { test as setup, expect } from '@playwright/test';
import path from 'node:path';

const AUTH_FILE = path.join(__dirname, '..', '..', 'playwright', '.auth', 'user.json');

setup('authenticate', async ({ page }) => {
  const email = process.env.TEST_USER_EMAIL;
  const password = process.env.TEST_USER_PASSWORD;

  if (!email || !password) {
    throw new Error(
      'auth.setup.ts requires TEST_USER_EMAIL and TEST_USER_PASSWORD env vars. ' +
      'Set them in .env.test.local or in your CI secrets. NEVER hardcode credentials.'
    );
  }

  // Adjust the sign-in URL + selectors to match your add-login output.
  // The defaults below match the Forja add-login Supabase template
  // (src/app/(auth)/sign-in/page.tsx).
  await page.goto('/sign-in');

  await page.getByLabel(/email/i).fill(email);
  await page.getByLabel(/password/i).fill(password);
  await page.getByRole('button', { name: /sign in|iniciar sesi[oó]n|entrar/i }).click();

  // Wait for redirect to authenticated area (adjust the URL to your app).
  await page.waitForURL((url) => !/\/sign-in\b/.test(url.pathname), { timeout: 15_000 });

  // Sanity-check that the session cookie is present before saving.
  const cookies = await page.context().cookies();
  expect(
    cookies.some((c) => /sb-.*-auth-token|supabase-auth-token/.test(c.name)),
    'Expected a Supabase auth cookie post-login. If your auth provider is different, ' +
    'adjust the assertion or remove it.',
  ).toBeTruthy();

  // Persist storage state so authenticated projects can reuse the session.
  await page.context().storageState({ path: AUTH_FILE });
});
