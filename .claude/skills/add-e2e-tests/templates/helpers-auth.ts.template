// Auth helpers for specs that need to log in/out mid-test (most don't —
// auth.setup.ts handles the default authenticated state).

import type { Page } from '@playwright/test';
import { expect } from '@playwright/test';

export interface LoginOptions {
  email: string;
  password: string;
  /** Override the sign-in URL. Defaults to '/sign-in'. */
  signInPath?: string;
  /** Override the post-login URL matcher. Defaults to "anything except /sign-in". */
  postLoginUrlMatcher?: (url: URL) => boolean;
}

/**
 * Log in via the UI. Use sparingly — most specs should rely on the
 * storageState from auth.setup.ts. This helper is for specs that test the
 * login flow itself or that need to switch users mid-test.
 */
export async function login(page: Page, opts: LoginOptions): Promise<void> {
  const signInPath = opts.signInPath ?? '/sign-in';
  await page.goto(signInPath);

  await page.getByLabel(/email/i).fill(opts.email);
  await page.getByLabel(/password/i).fill(opts.password);
  await page.getByRole('button', { name: /sign in|iniciar sesi[oó]n|entrar/i }).click();

  const matcher = opts.postLoginUrlMatcher ?? ((url) => !/\/sign-in\b/.test(url.pathname));
  await page.waitForURL(matcher, { timeout: 15_000 });
}

/**
 * Log out via the UI. Adjust the selector if your app's sign-out trigger
 * differs (e.g. a dropdown menu).
 */
export async function logout(page: Page): Promise<void> {
  const trigger = page.getByRole('button', { name: /sign out|cerrar sesi[oó]n|salir/i }).first();
  await trigger.click();
  await page.waitForURL(/\/(sign-in|login|$)/, { timeout: 10_000 });
}

/**
 * Assert that the page is in an authenticated state. Looks for the Supabase
 * auth cookie by default. Override with `cookieName` if your auth provider
 * sets a different cookie.
 */
export async function assertAuthenticated(
  page: Page,
  opts: { cookieName?: RegExp } = {},
): Promise<void> {
  const matcher = opts.cookieName ?? /sb-.*-auth-token|supabase-auth-token/;
  const cookies = await page.context().cookies();
  const found = cookies.some((c) => matcher.test(c.name));
  expect(
    found,
    `Expected an auth cookie matching ${matcher} but none was found. ` +
    `If your auth provider is different, pass a custom \`cookieName\`.`,
  ).toBeTruthy();
}
