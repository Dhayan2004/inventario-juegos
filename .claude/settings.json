{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "node scripts/statusline.mjs"
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/handoff.mjs --source=precompact"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ajolote": {
      "source": {
        "source": "directory",
        "path": "../../ajolote-contexto"
      }
    }
  },
  "enabledPlugins": {
    "casa@ajolote": true
  }
}
